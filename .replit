modules = ["nodejs-22", "postgresql-16"]
run = "npm run dev"

# Autoscale exposes exactly one port: the Express server serves API, previews and client.
[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]
