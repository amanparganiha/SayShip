modules = ["nodejs-22", "postgresql-16"]
run = "npm run dev"

# Autoscale exposes exactly one port: the Express server serves API, previews and client.
[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
# Install exactly what the lockfile says (dev dependencies included: the build needs Vite).
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
run = ["npm", "run", "start"]
