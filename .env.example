# Copy to .env for local development. On Replit, set these as Secrets instead.

# Local Postgres from docker-compose.yml (Replit PostgreSQL injects its own DATABASE_URL).
DATABASE_URL=postgres://sayship:sayship@localhost:5432/sayship

# At least 32 random characters. Signs nothing directly; used to derive the token-encryption key.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# LLM: "openai" or "mock". If unset: openai when OPENAI_API_KEY is present, otherwise mock (dev only).
LLM_PROVIDER=
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint (e.g. a proxy or Replit AI integrations).
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
# none|minimal|low|medium|high. Empty = "low" for gpt-5.x / o-series, not sent for other models.
OPENAI_REASONING_EFFORT=

# Generation runs per 24h: per user, and across all users (hard ceiling on model spend).
DAILY_RUN_LIMIT=40
GUEST_DAILY_RUN_LIMIT=10
GLOBAL_DAILY_RUN_LIMIT=500

# Reverse proxies in front of the app (Replit: 1). /api/health shows the client IP it produces.
TRUST_PROXY_HOPS=1
# Replit Autoscale needs 4 (Google load balancer + Replit proxy); verify with /api/health.

# Public URL of this server (OAuth callback base). Local: http://localhost:3000
APP_URL=http://localhost:3000

# Optional GitHub OAuth app for "Push to GitHub" (callback: $APP_URL/api/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
